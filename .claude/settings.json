{
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "Read",
      "Write",
      "Edit",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(ffmpeg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve"
      ]
    }
  }
}