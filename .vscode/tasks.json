{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Refresh Task Dashboard",
      "type": "shell",
      "command": "npm run tasks:dashboard",
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Open Task Dashboard",
      "type": "shell",
      "command": "Invoke-Item dashboard.html",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "Build CodeGraph Index",
      "type": "shell",
      "command": "npm run codegraph:build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Open HyperFrames Editor",
      "type": "shell",
      "command": "cd \"${workspaceFolder}/${input:project}\" && npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],
  "inputs": [
    {
      "id": "project",
      "type": "pickString",
      "description": "Pick a project to open in the HyperFrames editor",
      "options": [
