        "callcards-edu-ads/ad-06-badge-scanning",
        "callcards-edu-ads/ad-07-print-vendor",
        "callcards-edu-ads/ad-08-money-closing",
        "callcards-edu-ads/ad-09-one-scan",
        "callcards-edu-ads/ad-10-watch-this",
        "callcards-edu-ads/ad-11-spend-angle",
        "callcards-demo-ads/ad-01-pocket-competitor",
        "callcards-demo-ads/ad-02-fortune-booth",
        "callcards-demo-ads/ad-03-wet-cards",
